# Copy to .env for local runs. Never commit .env. In dev/test/prod these come from the
# Kubernetes ConfigMap, and secrets (the database URL) from AWS Secrets Manager.

# local | dev | test | prod  (API docs at /docs are only enabled for local)
PVO_ENVIRONMENT=local

# All routes are served under this prefix; React uses PVO_API_BASE_URL=https://<domain>/api
PVO_API_PREFIX=/api

# Local quick start uses SQLite. Lakebase / Postgres: postgresql+psycopg://<user>@<host>:5432/<db>?sslmode=require
# (the password / token is supplied by the platform, never written here)
PVO_DATABASE_URL=sqlite:///./pvo_local.db

# Okta (values from the Okta team; none of these are secrets)
PVO_OKTA_ISSUER=https://<company>.okta.com/oauth2/<authServerId>
PVO_OKTA_AUDIENCE=api://pvo
PVO_OKTA_CLIENT_ID=
PVO_OKTA_REQUIRED_SCOPE=pvo.api

# LOCAL ONLY, until the Okta app exists: sign in from React with a user name (e.g. "admin" for
# admin@example.test, or a full email) and the shared test password below. The API refuses to start
# with this on in any environment other than local. Okta values are ignored while on.
PVO_DEV_LOGIN=false
# Choose your own local test password (never a real one). Required when PVO_DEV_LOGIN=true.
PVO_DEV_PASSWORD=

# Only needed when the React app is served from a different domain (JSON list, exact origins only)
PVO_CORS_ORIGINS=[]

# Uploaded files (local folder for now; S3 / UC Volume later)
PVO_UPLOAD_DIR=./uploads
