# Copy to a local, untracked ".env" next to this file and fill in real
# values there. This sample holds variable NAMES and non-secret examples only
# -- never put a real API key in a file that gets committed. In CI/production,
# set real environment variables or inject them from a secrets manager.

# OpenAI-compatible endpoint with the Responses API (/v1/responses), https only.
STRUCTX_BASE_URL=https://api.openai.com/v1
# Model / deployment name. Must accept file input (PDF/PPTX) and images.
STRUCTX_MODEL=gpt-4o-mini
# Secret: set it in your shell/secrets manager or the untracked .env, never here.
STRUCTX_API_KEY=

# Headroom for hidden reasoning tokens plus the JSON answer.
STRUCTX_MAX_OUTPUT_TOKENS=16000
STRUCTX_TIMEOUT=600
STRUCTX_MAX_RETRIES=2
# Abort and retry a call that sends nothing for this many seconds. Healthy
# streamed calls have gone quiet for up to ~11 s at low effort (~16 s at the
# model default); the gateway sometimes holds a request ~5 min and then fails
# it (HTTP 500), or simply stalls past this limit, and a retry succeeds in
# seconds (seen 2026-11-04 on the synthetic deck: one call stalled at 20 s,
# the retry took 4 s).
STRUCTX_STALL_SECONDS=20
# per_field (default): one extraction call per top-level spec field, all at
# once -- the wall time is the slowest field's. single: one call for the
# whole spec (one answer, consistent names across fields, but written in one
# stream, so slower; see the README).
STRUCTX_CALLS=per_field
# per_field mode: this many calls at once (each sends the whole file). Lower
# it if the gateway rate-limits.
STRUCTX_EXTRACT_CONCURRENCY=10
# low (default) / medium / high, or "default" for the model's own. gpt-6.1-sol
# rejects minimal and none. At the model default a 13-slide CDP spent ~3 min
# reasoning before writing anything.
STRUCTX_REASONING_EFFORT=low

# How a .pptx is sent. "pdf" (default): saved as PDF by the locally installed
# PowerPoint (temp dir, deleted after), so the model sees every slide's
# image -- pictures, think-cell, diagrams. Falls back to "file" with a
# warning if PowerPoint fails. "file": the .pptx itself -- the gateway gives
# the model its text, tables and chart data only (no images; text-less
# slides are skipped, so slide numbers can shift).
# In either mode hidden slides are always left out (the output lists them,
# and every citation is written with the deck's own slide number, not the
# PDF's page number) and speaker notes are never sent. No setting for either.
STRUCTX_PPTX_MODE=pdf

# ---- The API (api/, README 5.5). Names only; values go in the untracked .env.
# One SQLite file for every asset. A relative path is taken from the project
# folder: the default below is db/structx.sqlite (git-ignored; it holds deck
# content). An absolute path works too (sqlite:///C:/data/structx.sqlite).
# Any other scheme is rejected for now. The server creates the file and its
# tables on first start; python db\init_db.py creates it empty beforehand.
STRUCTX_DATABASE_URL=sqlite:///db/structx.sqlite
# Secret: the bearer token every API call must send (Authorization: Bearer
# <token>), at least 16 characters. Set it here or in a secrets manager.
STRUCTX_API_TOKEN=
# Exact origins allowed to call the API from a browser, comma-separated
# (http://localhost:5173,https://ui.example). Empty: no CORS headers. Never *.
# The test front end (frontend/, README 5.6) runs on http://localhost:5173.
STRUCTX_CORS_ORIGINS=http://localhost:5173
# Upload limit in MB (default 50, the gateway's documented per-file limit).
STRUCTX_MAX_UPLOAD_MB=
